# ── Production — EXEMPLE (copier en .env.prod sur le serveur) ─
# NE JAMAIS committer .env.prod dans Git !
# Créer ce fichier directement sur le serveur OVH

# Base de données (OVH Managed PostgreSQL recommandé)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Sécurité JWT (générer avec : python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=VOTRE_CLE_SECRETE_PRODUCTION

# CORS : uniquement votre domaine
CORS_ORIGINS=https://votre-domaine.tn,https://www.votre-domaine.tn

# Lien CRM de prospection (route /crm/activite) : clé longue et aléatoire,
# à recopier dans le CRM (Paramètres → Lien localizi.tn). Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRM_API_KEY=
